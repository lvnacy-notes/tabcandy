# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Only pnpm-lock.yaml is committed; guard against an npm/yarn lockfile
# sneaking back in from someone running the wrong package manager.
package-lock.json
yarn.lock

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Remove local builds
dist/

# Generated coverage report output (html/json/text) - regenerated by every
# `vitest run --coverage`. Not the same as `.coverage/baseline.json`, which
# *is* committed - that's the hand-maintained Ratchet floor, not a report.
.coverage/report/

# Remove pnpm resources
.pnpm-store

# Remove test files, directories, and temp shit
tab-candy-images/
quotes.md
**/temp.md
**/updates.js
**/updates.ts
.obsidian/plugins/tabcandy/